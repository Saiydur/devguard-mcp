    { "id": "obf-loader-b", "regex": "_0x355e", "literal": "_0x355e", "campaign": "polinrider" },
    { "id": "stage-tag-a9", "regex": "A9-3427-11", "literal": "A9-3427-11", "campaign": "polinrider" },
    { "id": "seed-rmcej", "regex": "rmcej%otb%", "literal": "rmcej%otb%", "campaign": "polinrider" },
    { "id": "seed-cot3t", "regex": "Cot%3t=shtP", "literal": "Cot%3t=shtP", "campaign": "polinrider" },
    { "id": "xor-key-1", "regex": "q4FZkxX\\{!h,Sr3=@", "literal": "q4FZkxX{!h,Sr3=@", "campaign": "polinrider" },
    { "id": "xor-key-2", "regex": "2\\[gWfGj;<:-93Z\\^C", "literal": "2[gWfGj;<:-93Z^C", "campaign": "polinrider" },
    { "id": "xor-key-3", "regex": "m6:tTh\\^D\\)cBz\\?NM\\]", "literal": "m6:tTh^D)cBz?NM]", "campaign": "polinrider" },
    { "id": "stage-url-path", "regex": "/0x/cls", "literal": "/0x/cls", "campaign": "polinrider" },
    { "id": "runner-name", "regex": "\\.npm-ws", "literal": ".npm-ws", "campaign": "polinrider" }
  ],
  "weak_markers": [
    { "id": "global-bang", "regex": "global\\[\\s*[\"']![\"']\\s*\\]|global\\[\\s*[\"']\\\\u0021[\"']\\s*\\]", "campaign": "polinrider" },
    { "id": "global-i-tag", "regex": "global\\.i\\s*=\\s*[\"']A\\d+-", "campaign": "polinrider" },
    { "id": "global-v-tag", "regex": "global\\[\\s*[\"']_V[\"']\\s*\\]\\s*=\\s*[\"']\\d+-", "campaign": "polinrider" }
  ],
